<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#2F2F2F"/>
    <corners android:radius="16dp"/> <!-- Increased corner radius for a more rounded look -->
    <stroke android:width="3dp" android:color="#E63946"/> <!-- Slightly thicker stroke for emphasis -->
    <padding android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp"/> <!-- Added padding for inner content -->
    <gradient
        android:startColor="#3A3A3A"
        android:centerColor="#2F2F2F"
        android:endColor="#1C1C1C"
        android:angle="45"/>
    <size
        android:width="300dp"
        android:height="200dp"/>
</shape>