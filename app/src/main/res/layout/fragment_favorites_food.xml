<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/favoritesDialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_rounded"
    android:layout_margin="16dp"
    android:elevation="6dp"
    android:layout_gravity="center"
    android:clipToPadding="false">

    <!-- Barra de búsqueda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_rounded_dark"
        android:padding="8dp">

        <EditText
            android:id="@+id/searchFavoritesEditText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Buscar favorito..."
            android:textColor="#FFFFFF"
            android:textColorHint="#BBBBBB"
            android:inputType="text"
            android:background="@null"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/searchFavoritesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#E63946"
            android:contentDescription="Buscar alimento favorito" />
    </LinearLayout>

    <!-- Lista de favoritos -->
    <ListView
        android:id="@+id/favoritesListView"
        android:layout_width="match_parent"
        android:layout_height="800dp"
        android:layout_marginTop="16dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:background="#1C1C1C"
        android:padding="4dp"
        android:clipToPadding="false" />

</LinearLayout>
