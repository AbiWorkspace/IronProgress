<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchDialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_rounded"
    android:layout_margin="16dp"
    android:elevation="6dp"
    android:layout_gravity="center"
    android:clipToPadding="false">

    <!-- Barra de búsqueda con íconos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_rounded_dark"
        android:padding="8dp">

        <EditText
            android:id="@+id/searchFoodEditText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Buscar alimento..."
            android:textColor="#FFFFFF"
            android:textColorHint="#BBBBBB"
            android:inputType="text"
            android:background="@null"
            android:textSize="16sp" />

        <!-- Botón lector de código de barras -->
        <ImageButton
            android:id="@+id/barcodeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_barcode"
            android:contentDescription="Buscar por código" />

        <!-- Botón filtro macro (icono embudo) -->
        <ImageButton
            android:id="@+id/extraFilterButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_filter_menu"
            android:contentDescription="Filtros macro" app:tint="#E63946" />

        <!-- Botón de búsqueda -->
        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Buscar alimento"
            app:tint="#E63946" />

    </LinearLayout>

    <!-- Spinner filtros rápidos -->
    <Spinner
        android:id="@+id/filterSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#E63946"
        android:popupBackground="#2F2F2F"
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:textColor="#FFFFFF"/>

    <!-- Lista de resultados -->
    <ListView
        android:id="@+id/foodResultsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:background="#1C1C1C"
        android:padding="4dp"/>
</LinearLayout>
