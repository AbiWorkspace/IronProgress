<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="0dp"
    android:layout_margin="0dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- 🔥 Fila: Título + Estrella -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="¿Cuántos gramos de...?"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnFavToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_star_toggle"
            android:background="@android:color/transparent"
            android:duplicateParentState="true"
            android:contentDescription="Añadir a favoritos"/>



    </LinearLayout>

    <!-- 🔥 Imagen del alimento -->
    <ImageView
        android:id="@+id/foodImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true" />

    <!-- 🔥 Marca -->
    <TextView
        android:id="@+id/foodBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/foodDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="≈ 0 kcal • P 0g • C 0g • F 0g"
        android:textColor="#BBBBBB"
        android:textSize="15sp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="4dp" />


    <!-- 🔥 selector de porciones -->
    <Spinner
        android:id="@+id/spinnerPortions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        />

    <!-- 🔥 Input de gramos -->
    <EditText
        android:id="@+id/inputGrams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cantidad en gramos"
        android:background="@drawable/bg_input_field"
        android:inputType="numberDecimal"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"
        android:padding="10dp"
        android:textSize="15sp" />

    <!-- 🔥 Botones Aceptar y Cancelar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp"
        android:weightSum="2">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:text="Cancelar"
            android:textColor="#E63946"
            android:background="@drawable/bg_button_outline_red" />

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="Aceptar"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_filled_red" />
    </LinearLayout>

</LinearLayout>
