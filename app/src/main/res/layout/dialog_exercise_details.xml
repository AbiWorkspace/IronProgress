<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1C1C1C"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen del Ejercicio -->
        <ImageView
            android:id="@+id/imageExercise"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder"
            android:background="@drawable/rounded_corners"
            android:elevation="8dp" />

        <!-- Nombre del Ejercicio -->
        <TextView
            android:id="@+id/textExerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Ejercicio"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- Descripción del Ejercicio -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#2F2F2F"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción del ejercicio"
                android:textColor="#BBBBBB"
                android:textSize="16sp"
                android:padding="16dp" />
        </androidx.cardview.widget.CardView>

        <!-- Músculos trabajados y sinérgicos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#2F2F2F"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textMusclesWorked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Músculos trabajados: ..."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/textSynergistMuscles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Músculos sinérgicos: ..."
                    android:textColor="#BBBBBB"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Estadísticas (RM, PR, Volumen) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#2F2F2F"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textRM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RM Estimado: 80 kg"
                    android:textColor="#E63946"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/textPersonalRecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personal Record: 100 kg"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/textVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Volumen: 0"
                    android:textColor="#39FF14"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Gráfica de Progreso -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartExerciseProgress"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_corners" />

        <!-- Spinner para seleccionar RPE -->
        <Spinner
            android:id="@+id/spinnerRpeFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/rpe_array"
            android:spinnerMode="dropdown"
            android:backgroundTint="#2F2F2F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Botón cerrar -->
        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CERRAR"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E63946"
            android:padding="12dp"
            android:elevation="4dp" />

    </LinearLayout>
</ScrollView>