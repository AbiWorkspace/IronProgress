<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#3F3F3F">

    <EditText
        android:id="@+id/foodItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del alimento"
        android:maxLines="1"
        android:inputType="text"
        android:maxLength="20"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@null" />

    <EditText
        android:id="@+id/foodItemGrams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cantidad (g)"
        android:maxLines="1"
        android:inputType="number"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@null" />

    <EditText
        android:id="@+id/foodItemCalories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Calorías"
        android:maxLines="1"
        android:inputType="number"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@null" />

    <EditText
        android:id="@+id/foodItemBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Marca (opcional)"
        android:maxLines="1"
        android:inputType="text"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@null" />
</LinearLayout>